# Copy once: cp app/.env.example app/.env
# Single env file for Compose, Ansible inventory group, and /opt/<PROJECT_HOSTNAME>/

PROJECT_HOSTNAME=prod
DOCKER_GID=999

# Ops panel public host (DNS A → floating IP)
PROD_PUBLIC_HOST=status.example.com
PROD_ADMIN_USER=admin
PROD_ADMIN_PASSWORD=__CHANGE_ME__
PROD_SESSION_SECRET=__CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32__

LE_EMAIL=admin@example.com
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME__

# Optional paired host (leave empty for a standalone lab)
PEER_PUBLIC_URL=
LOKI_INGEST_BIND=127.0.0.1
LOKI_INGEST_PORT=3100

MYSQL_ROOT_PASSWORD=__CHANGE_ME__
MYSQL_EXPORTER_PASSWORD=__CHANGE_ME__
EXAMPLE_DB_PASSWORD=__CHANGE_ME__
EXAMPLE_APP_KEY=__CHANGE_ME__
